# Required. Get a key at https://tik.tools/pricing. Server-side only: never rename it to NEXT_PUBLIC_*.
TIKTOOLS_API_KEY=

# Optional. Which roster to show (Agency plan). Defaults to your first roster.
ROSTER_ID=
# Optional. Region for the recruit page and the fallback watchlist (UK+, US+, DE, MENA ...).
REGION=UK+
# Optional. Discord webhook URL that receives go-live alerts from app/api/webhooks/tiktools.
DISCORD_WEBHOOK_URL=
# Optional. Your own webhook secret (16+ chars, letters, digits, _ . -). Used by setup-alerts and the webhook route.
TIKTOOLS_WEBHOOK_SECRET=
